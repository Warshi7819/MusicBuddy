@page
@model MusicBuddyWeb.Pages.PlaylistsModel
@{
    ViewData["Title"] = "Playlist Manager";
    var isSid = Model.FileType == "sid";
}

 <div id="pe-container" data-file-type="@Model.FileType">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <select class="form-select form-select-sm pe-playlist-select" id="pe-playlist-select"
                hx-get="/Playlists?handler=PlaylistList&type=@Model.FileType"
                hx-trigger="load"
                hx-swap="innerHTML">
            <option value="">-- Select playlist --</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" id="pe-create-btn" title="Create playlist">
            <i class="bi bi-plus"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-rename-btn" title="Rename playlist" disabled>
            <i class="bi bi-pencil"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-danger" id="pe-delete-btn" title="Delete playlist" disabled>
            <i class="bi bi-trash"></i>
        </button>
        <button type="button" class="btn btn-sm btn-outline-danger" id="pe-clear-btn" title="Clear playlist" disabled>
            <i class="bi bi-trash3"></i> Clear
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" id="pe-back-btn" title="Back">
            <i class="bi bi-arrow-left"></i> Back
        </button>
        <span class="small pe-saved-indicator" id="pe-saved-indicator" style="display:none;">
            <i class="bi bi-check2-circle me-1"></i>Saved
        </span>
    </div>

    <div class="pe-name-collapse" id="pe-name-collapse">
        <div class="d-flex align-items-center gap-2 mb-3" id="pe-name-wrap">
            <label class="small text-muted text-nowrap" id="pe-name-label">New playlist name:</label>
            <input type="text" class="form-control form-control-sm" id="pe-name-input" maxlength="100" autocomplete="off" style="max-width: 300px;">
            <button type="button" class="btn btn-sm btn-primary" id="pe-name-save">
                <i class="bi bi-check-lg"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-name-cancel">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="pe-panes">
        <div class="pe-pane pe-playlist-pane">
            <div class="pe-pane-header">
                <span class="fw-semibold"><i class="bi bi-list-ul me-1"></i>Playlist</span>
            </div>
            <div id="pe-tracks" class="list-group list-group-flush pe-list">
                <div class="text-center text-muted py-4 small">
                    <i class="bi bi-arrow-right-circle me-2"></i>
                    Select or create a playlist
                </div>
            </div>
        </div>
        <div class="pe-pane pe-library-pane">
            <div class="pe-pane-header">
                <span class="fw-semibold"><i class="bi bi-folder2-open me-1"></i>Library</span>
                <div class="d-flex align-items-center gap-2">
                    @if (!isSid)
                    {
                        <div class="btn-group btn-group-sm me-2" role="group">
                            <input type="radio" class="btn-check" name="pe-lib-mode" id="pe-mode-browse" value="browse" checked>
                            <label class="btn btn-outline-secondary" for="pe-mode-browse"><i class="bi bi-folder me-1"></i>Browse</label>
                            <input type="radio" class="btn-check" name="pe-lib-mode" id="pe-mode-search" value="search">
                            <label class="btn btn-outline-secondary" for="pe-mode-search"><i class="bi bi-search me-1"></i>Search</label>
                        </div>
                    }
                    <small class="text-muted text-nowrap" id="pe-selected-count">0 selected</small>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-select-all-btn">Select all</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-deselect-all-btn">Deselect all</button>
                    <button type="button" class="btn btn-sm btn-primary" id="pe-add-selected-btn" disabled>
                        <i class="bi bi-plus-lg me-1"></i>Add selected
                    </button>
                </div>
            </div>
            <div id="pe-browse-controls">
                <div class="pe-pane-header pe-breadcrumb-bar">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 pe-breadcrumb" id="pe-breadcrumb"></ol>
                    </nav>
                </div>
            </div>
            <div id="pe-search-controls" style="display:none;">
                <div class="pe-pane-header" style="gap: 0.5rem; flex-wrap: wrap;">
                    <input type="text" class="form-control form-control-sm" id="pe-search-song"
                           placeholder="Song name" autocomplete="off" style="max-width: 200px;">
                    <input type="text" class="form-control form-control-sm" id="pe-search-artist"
                           placeholder="Artist" autocomplete="off" style="max-width: 200px;">
                    <input type="text" class="form-control form-control-sm" id="pe-search-genre"
                           placeholder="Genre" autocomplete="off" style="max-width: 150px;">
                    <button type="button" class="btn btn-sm btn-primary" id="pe-search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            <div class="list-group list-group-flush pe-list" id="pe-library"
                 hx-get="/Playlists?handler=Library&type=@Model.FileType&path="
                 hx-trigger="load"
                 hx-swap="innerHTML">
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>

    <div class="pe-footer mt-3 d-flex align-items-center gap-2 flex-wrap">
        <div class="d-flex align-items-center gap-2 pe-transport" id="pe-transport" style="display:none;">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-t-prev" title="Previous">
                <i class="bi bi-skip-start-fill"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-t-play" title="Play/Pause">
                <i class="bi bi-play-fill"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="pe-t-next" title="Next">
                <i class="bi bi-skip-end-fill"></i>
            </button>
            <input type="range" class="pe-t-seek" id="pe-t-seek" min="0" max="1000" value="0" step="1" title="Seek">
            <small class="text-muted text-nowrap" id="pe-t-time">0:00 / 0:00</small>
        </div>
        <small class="text-muted me-auto">
            <i class="bi bi-mouse me-1"></i>Drag entries to reorder, or drag tracks and albums from the Library.
            <i class="bi bi-lightning-charge-fill ms-2 me-1"></i>Everything saves automatically.
        </small>
    </div>
</div>

<div class="pe-toast-container" id="pe-toast-container"></div>

@section Scripts {
    @if (Model.FileType == "sid")
    {
        <script src="~/lib/jsSID.js"></script>
    }
    <script src="~/js/resume-cookie.js" asp-append-version="true"></script>
    <script src="~/js/playlist-manager.js" asp-append-version="true"></script>
}

@page
@model MusicBuddyWeb.Pages.PlaylistsModel
@{
    ViewData["Title"] = "Playlists";
}

<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <a class="nav-link" asp-page="/Mp3"><i class="bi bi-file-earmark-music me-1"></i>MP3 Player</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/Sid"><i class="bi bi-cassette me-1"></i>jsSID Player</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/WebSid"><i class="bi bi-cassette me-1"></i>webSID Player</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" asp-page="/Playlists"><i class="bi bi-music-note-list me-1"></i>Playlists</a>
    </li>
</ul>

<div class="card shadow-sm">
    <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <i class="bi bi-collection text-primary" style="font-size: 2rem;"></i>
        <div class="flex-grow-1">
            <h5 class="mb-1">Playlist Manager</h5>
            <small class="text-muted">
                Create, edit, reorder and fill playlists by dragging tracks and albums from the library.
                Changes save automatically.
            </small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select" id="pm-type-select" style="width: auto;" aria-label="File type">
                <option value="mp3">MP3</option>
                <option value="sid">SID</option>
            </select>
            <button type="button" class="btn btn-primary" id="pm-open-editor-btn"
                    onclick="playlistEditor.open({ fileType: document.getElementById('pm-type-select').value })">
                <i class="bi bi-pencil-square me-1"></i>Open Playlist Manager
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="Shared/_PlaylistEditorModal" />
    <script>
        (function () {
            var typeSelect = document.getElementById('pm-type-select');
            typeSelect.addEventListener('change', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('playlistEditorModal')).show();
            });
            bootstrap.Modal.getOrCreateInstance(document.getElementById('playlistEditorModal')).show();
        })();
    </script>
}

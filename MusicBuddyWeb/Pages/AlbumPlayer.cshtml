@page "/AlbumPlayer"
@model AlbumPlayerModel
@{
    ViewData["Title"] = Model.TrackModel.AlbumName;
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div class="d-flex align-items-center gap-2">
        @if (Model.TrackModel.Artist.IsUncatalogued)
        {
            <a href="/Albums" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>All Artists
            </a>
        }
        else
        {
            <a href="/Albums?artist=@Uri.EscapeDataString(Model.TrackModel.Artist.Name)" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>@Model.TrackModel.Artist.Name
            </a>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="random-open-btn"
                onclick="bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('random-offcanvas')).show();">
            <i class="bi bi-shuffle me-1"></i>Random
        </button>
    </div>
</div>

@if (Model.TrackModel.Tracks.Count > 0)
{
    var metaParts = new List<string>();
    if (!string.IsNullOrEmpty(Model.TrackModel.AlbumArtist)) metaParts.Add(Model.TrackModel.AlbumArtist);
    if (Model.TrackModel.Year.HasValue && Model.TrackModel.Year > 0) metaParts.Add(Model.TrackModel.Year.ToString()!);
    if (!string.IsNullOrEmpty(Model.TrackModel.Genre)) metaParts.Add(Model.TrackModel.Genre);

    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="album-art-wrap flex-shrink-0" style="width: 96px; height: 96px;">
                    @if (!Model.TrackModel.Artist.IsUncatalogued && Model.TrackModel.Tracks.Count > 0)
                    {
                        <img class="album-art"
                             src="/api/albumart?path=@Uri.EscapeDataString(Model.TrackModel.Tracks[0].Path)"
                             loading="lazy"
                             decoding="async"
                             alt="@Model.TrackModel.AlbumName"
                             onload="if(this.naturalWidth===1&&this.naturalHeight===1){this.style.display='none';var n=this.nextElementSibling;if(n)n.style.display='';}"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='';">
                    }
                    <div class="album-art-placeholder" @(!Model.TrackModel.Artist.IsUncatalogued && Model.TrackModel.Tracks.Count > 0 ? Html.Raw("style=\"display:none\"") : "")>
                        <i class="bi bi-disc" style="font-size: 1.8rem;"></i>
                    </div>
                </div>
                <div>
                    <h5 class="mb-1">@Model.TrackModel.AlbumName</h5>
                    @if (metaParts.Count > 0)
                    {
                        <small class="text-muted">@string.Join(" \u00b7 ", metaParts)</small>
                    }
                </div>
            </div>
            <div class="alb-vu-wrap ms-auto">
                <canvas id="alb-vu-canvas"></canvas>
            </div>
        </div>
    </div>
}

@if (Model.TrackModel.Tracks.Count > 0)
{
    <div class="card shadow-sm mb-3" id="album-player-bar">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" id="alb-prev" title="Previous track">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button class="btn btn-sm btn-primary" id="alb-play" title="Play" style="@(Model.TrackModel.RandomTrackIndex >= 0 ? "display:none;" : "")">
                    <i class="bi bi-play-fill"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary" id="alb-pause" title="Pause" style="@(Model.TrackModel.RandomTrackIndex >= 0 ? "" : "display:none;")">
                    <i class="bi bi-pause-fill"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary" id="alb-next" title="Next track">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
                <span class="text-truncate small fw-semibold" id="alb-now-title" style="min-width:0;"></span>
                <span class="text-muted small text-truncate" id="alb-now-artist" style="min-width:0; display:none;"></span>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <span class="text-muted small flex-shrink-0" id="alb-time">0:00</span>
                <div class="flex-grow-1">
                    <div class="progress" style="height: 4px; cursor: pointer;" id="alb-seek-bar">
                        <div class="progress-bar bg-primary" id="alb-seek-fill" style="width: 0%"></div>
                    </div>
                </div>
                <span class="text-muted small flex-shrink-0" id="alb-duration">0:00</span>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <i class="bi bi-volume-up text-muted"></i>
                <input type="range" class="form-range" id="alb-volume" min="0" max="100" value="80" style="width: 100px;">
                <span id="random-indicator" class="@(Model.TrackModel.RandomTrackIndex < 0 ? "d-none" : "") small text-muted align-items-center gap-1 ms-auto">
                    <span id="random-indicator-dot" class="d-inline-block rounded-circle"
                          style="width:8px;height:8px;background:@(Model.TrackModel.RandomTrackIndex < 0 ? "#6c757d" : "#2CFF05");"></span>
                    <span id="random-indicator-text">@(Model.TrackModel.RandomTrackIndex < 0 ? "Random" : GetRandomLabel(Model.TrackModel.RandomParams))</span>
                </span>
            </div>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="list-group list-group-flush" id="track-list"
         data-tracks="@System.Text.Json.JsonSerializer.Serialize(Model.TrackModel.Tracks, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })"
         data-random-index="@Model.TrackModel.RandomTrackIndex"
         data-random-params="@(Model.TrackModel.RandomParams ?? "")">
        @for (var i = 0; i < Model.TrackModel.Tracks.Count; i++)
        {
            var track = Model.TrackModel.Tracks[i];
            <button type="button"
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                    data-index="@i"
                    data-path="@track.Path"
                    onclick="albumPlayer.playTrack(@i)">
                <span class="text-truncate">@track.DisplayTitle</span>
                <span class="text-muted small ms-2 flex-shrink-0">@track.DisplayDuration</span>
            </button>
        }
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="random-offcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title"><i class="bi bi-shuffle me-2"></i>Random Play</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <a href="/AlbumPlayer?random=true"
           class="list-group-item list-group-item-action mb-3 fw-semibold">
            <i class="bi bi-shuffle me-2"></i>Random Song (any)
        </a>
        <div class="accordion" id="random-accordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#random-artists-body" aria-expanded="false">
                        <i class="bi bi-people me-2"></i>Artists <small class="text-muted ms-1">(@Model.RandomArtists.Count)</small>
                    </button>
                </h2>
                <div id="random-artists-body" class="accordion-collapse collapse" data-bs-parent="#random-accordion">
                    <div class="accordion-body p-2">
                        <input type="text" class="form-control form-control-sm mb-2" id="random-artist-search"
                               placeholder="Search artists..." oninput="filterList(this, 'random-artist-list')">
                        <div class="list-group list-group-flush" id="random-artist-list" style="max-height:300px;overflow-y:auto;">
                            @foreach (var artistName in Model.RandomArtists)
                            {
                                <a href="/AlbumPlayer?random=true&artist=@Uri.EscapeDataString(artistName)"
                                   class="list-group-item list-group-item-action"
                                   data-label="@artistName.ToLower()">
                                    @artistName
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#random-genres-body" aria-expanded="false">
                        <i class="bi bi-tag me-2"></i>Genres <small class="text-muted ms-1">(@Model.RandomGenres.Count)</small>
                    </button>
                </h2>
                <div id="random-genres-body" class="accordion-collapse collapse" data-bs-parent="#random-accordion">
                    <div class="accordion-body p-2">
                        <input type="text" class="form-control form-control-sm mb-2" id="random-genre-search"
                               placeholder="Search genres..." oninput="filterList(this, 'random-genre-list')">
                        <div class="list-group list-group-flush" id="random-genre-list" style="max-height:300px;overflow-y:auto;">
                            @if (Model.RandomGenres.Count == 0)
                            {
                                <span class="list-group-item text-muted small">No genres found</span>
                            }
                            else
                            {
                                @foreach (var g in Model.RandomGenres)
                                {
                                    <a href="/AlbumPlayer?random=true&genre=@Uri.EscapeDataString(g)"
                                       class="list-group-item list-group-item-action"
                                       data-label="@g.ToLower()">
                                        @g
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function filterList(input, listId) {
        var q = input.value.toLowerCase();
        var list = document.getElementById(listId);
        if (!list) return;
        var items = list.querySelectorAll('.list-group-item');
        items.forEach(function (item) {
            var show = !q || (item.dataset.label || '').indexOf(q) !== -1;
            item.classList.toggle('d-none', !show);
        });
    }
</script>

<script>
    if (window.albumPlayer && typeof window.albumPlayer.initFromView === 'function') {
        window.albumPlayer.initFromView();
    }
</script>

@section Scripts {
    <script src="~/js/vu-meter.js" asp-append-version="true"></script>
    <script src="~/js/album-player.js" asp-append-version="true"></script>
}

@functions {
    string GetRandomLabel(string? queryParams)
    {
        if (string.IsNullOrEmpty(queryParams)) return "Random";
        foreach (var part in queryParams.Split('&'))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2)
            {
                var key = Uri.UnescapeDataString(kv[0]);
                var val = Uri.UnescapeDataString(kv[1]);
                if (key == "artist") return $"Random - Artist: {val}";
                if (key == "genre") return $"Random - Genre: {val}";
            }
        }
        return "Random";
    }
}

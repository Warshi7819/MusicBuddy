@page
@model MusicBuddyWeb.Pages.AlbumsModel
@{
    ViewData["Title"] = "Album Overview";
}

<div id="albums-container"
     hx-get="/Albums?handler=@Model.InitialHandler@(Model.InitialQuery)"
     hx-trigger="load"
     hx-swap="innerHTML">
    <div class="text-muted py-4">
        <i class="bi bi-hourglass-split me-1"></i>Loading albums...
    </div>
</div>

<div id="albums-empty" class="d-none text-muted py-4">
    <i class="bi bi-music-note-beamed me-1"></i>No albums found.
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="random-offcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title"><i class="bi bi-shuffle me-2"></i>Random Play</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <a href="#"
           class="list-group-item list-group-item-action mb-3 fw-semibold"
           hx-get="/Albums?handler=RandomTrackView"
           hx-target="#albums-container"
           hx-swap="innerHTML"
           hx-push-url="true"
           onclick="bootstrap.Offcanvas.getInstance(document.getElementById('random-offcanvas')).hide();">
            <i class="bi bi-shuffle me-2"></i>Random Song (any)
        </a>
        <div class="accordion" id="random-accordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#random-artists-body" aria-expanded="false">
                        <i class="bi bi-people me-2"></i>Artists <small class="text-muted ms-1" id="random-artist-count"></small>
                    </button>
                </h2>
                <div id="random-artists-body" class="accordion-collapse collapse" data-bs-parent="#random-accordion">
                    <div class="accordion-body p-2">
                        <input type="text" class="form-control form-control-sm mb-2" id="random-artist-search"
                               placeholder="Search artists..." oninput="filterList(this, 'random-artist-list', 'random-artist-count')">
                        <div class="list-group list-group-flush" id="random-artist-list"
                             style="max-height:300px;overflow-y:auto;"
                             hx-get="/Albums?handler=RandomArtistList"
                             hx-trigger="revealed"
                             hx-swap="innerHTML">
                        </div>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#random-genres-body" aria-expanded="false">
                        <i class="bi bi-tag me-2"></i>Genres <small class="text-muted ms-1" id="random-genre-count"></small>
                    </button>
                </h2>
                <div id="random-genres-body" class="accordion-collapse collapse" data-bs-parent="#random-accordion">
                    <div class="accordion-body p-2">
                        <input type="text" class="form-control form-control-sm mb-2" id="random-genre-search"
                               placeholder="Search genres..." oninput="filterList(this, 'random-genre-list', 'random-genre-count')">
                        <div class="list-group list-group-flush" id="random-genre-list"
                             hx-get="/Albums?handler=RandomGenreList"
                             hx-trigger="revealed"
                             hx-swap="innerHTML">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function filterList(input, listId, countId) {
        var q = input.value.toLowerCase();
        var list = document.getElementById(listId);
        if (!list) return;
        var items = list.querySelectorAll('.list-group-item');
        var visible = 0;
        items.forEach(function (item) {
            var show = !q || (item.dataset.label || '').indexOf(q) !== -1;
            item.classList.toggle('d-none', !show);
            if (show) visible++;
        });
        var countEl = document.getElementById(countId);
        if (countEl) countEl.textContent = '(' + visible + ')';
    }

    function stopAlbumPlayer() {
        if (typeof window.albumPlayer !== 'undefined' && typeof window.albumPlayer.stop === 'function') {
            window.albumPlayer.stop();
        }
    }

    if (!window.__albumsNavStopBound) {
        window.__albumsNavStopBound = true;

        document.body.addEventListener('htmx:afterSwap', function(e) {
            if (e.detail.target.id === 'albums-container') {
                var empty = document.getElementById('albums-empty');
                var hasContent = e.detail.target.querySelectorAll('.album-card, .list-group-item').length > 0;
                if (empty) {
                    empty.classList.toggle('d-none', hasContent);
                }
            }
        });

        document.body.addEventListener('htmx:beforeSwap', function(e) {
            if (e.detail.target.id === 'albums-container') {
                stopAlbumPlayer();
            }
        });

        window.addEventListener('beforeunload', stopAlbumPlayer);
        window.addEventListener('pagehide', stopAlbumPlayer);
        window.addEventListener('popstate', stopAlbumPlayer);
        document.addEventListener('htmx:historyRestore', stopAlbumPlayer);
    }
</script>

@section Scripts {
    <script src="~/js/album-player.js" asp-append-version="true"></script>
    <script src="~/js/album-bridge.js" asp-append-version="true"></script>
}

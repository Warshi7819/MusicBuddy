@page
@model MusicBuddyWeb.Pages.AlbumsModel
@{
    ViewData["Title"] = "Album Overview";
}

<div id="albums-container"
     hx-get="/Albums?handler=@Model.InitialHandler@(Model.InitialQuery)"
     hx-trigger="load"
     hx-swap="innerHTML">
    <div class="text-muted py-4">
        <i class="bi bi-hourglass-split me-1"></i>Loading albums...
    </div>
</div>

@page
@model MusicBuddyWeb.Pages.AlbumsModel
@{
    ViewData["Title"] = "Album Overview";
}

<div id="albums-loading" class="text-muted py-4">
    <i class="bi bi-hourglass-split me-1"></i>Loading albums...
</div>

<div id="albums-content" class="d-none">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="albums-refresh-btn">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
    </div>
    <div id="albums-header" class="d-none mb-3">
        <a href="/Albums" class="btn btn-outline-secondary btn-sm me-2" id="albums-back-btn">
            <i class="bi bi-arrow-left me-1"></i>All Artists
        </a>
        <span class="fs-5 fw-semibold" id="albums-artist-name"></span>
    </div>
    <div class="row" id="albums-grid"></div>
    <div id="albums-track-view" class="d-none">
        <div class="card shadow-sm mb-3 d-none" id="album-info-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="album-art-wrap flex-shrink-0" style="width: 96px; height: 96px;">
                    <img class="album-art d-none" id="album-info-art" alt="Album art">
                    <div class="album-art-placeholder" id="album-info-art-ph">
                        <i class="bi bi-disc" style="font-size: 1.8rem;"></i>
                    </div>
                </div>
                <div>
                    <h5 class="mb-1" id="album-info-name"></h5>
                    <small class="text-muted" id="album-info-meta"></small>
                </div>
            </div>
        </div>
        <div class="card shadow-sm mb-3 d-none" id="album-player-bar">
            <div class="card-body py-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" id="alb-prev" title="Previous track">
                        <i class="bi bi-skip-start-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-primary" id="alb-play" title="Play">
                        <i class="bi bi-play-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" id="alb-pause" title="Pause" style="display:none;">
                        <i class="bi bi-pause-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" id="alb-next" title="Next track">
                        <i class="bi bi-skip-end-fill"></i>
                    </button>
                    <span class="text-truncate small fw-semibold" id="alb-now-title" style="min-width:0;"></span>
                    <span class="text-muted small flex-shrink-0" id="alb-time">0:00</span>
                    <div class="flex-grow-1">
                        <div class="progress" style="height: 4px; cursor: pointer;" id="alb-seek-bar">
                            <div class="progress-bar bg-primary" id="alb-seek-fill" style="width: 0%"></div>
                        </div>
                    </div>
                    <span class="text-muted small flex-shrink-0" id="alb-duration">0:00</span>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="list-group list-group-flush" id="track-list"></div>
        </div>
    </div>
</div>

<div id="albums-empty" class="d-none text-muted py-4">
    <i class="bi bi-music-note-beamed me-1"></i>No albums found.
</div>

@section Scripts {
    <script src="~/js/albums.js" asp-append-version="true"></script>
    <script>
        (function () {
            var selectedArtist = @Html.Raw(Model.SelectedArtist != null ? $"\"{Model.SelectedArtist}\"" : "null");
            var selectedAlbum = @Html.Raw(Model.SelectedAlbum != null ? $"\"{Model.SelectedAlbum}\"" : "null");
            albums.init(selectedArtist, selectedAlbum);

            window.addEventListener('beforeunload', function () {
                if (typeof albums.stopPlayer === 'function') albums.stopPlayer();
            });
        })();
    </script>
}

@page
@model MusicBuddyWeb.Pages.Settings.ApiKeysModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "API Keys";
}

<h2 class="mb-4"><i class="bi bi-key-fill"></i> API Keys</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
}
@if (Model.Saved)
{
    <div class="alert alert-success py-2">Saved.</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Barcode lookup keys</h5>
        <p class="text-muted small">
            These keys are stored in the database and used by the <a asp-page="/Scan">Scan</a> page when looking up CD barcodes.
            The Scan page always tries <strong>iTunes</strong> first (no key needed), then falls back to Discogs.
            Leave a field empty to clear the stored value.
        </p>
        <form method="post" asp-page-handler="Save" class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="discogsToken">Discogs Token</label>
                <input type="password" id="discogsToken" name="discogsToken" value="@Model.DiscogsToken" class="form-control"
                       autocomplete="new-password" placeholder="e.g. AbCdEf...">
                <div class="form-text">
                    Generate one at <a href="https://www.discogs.com/settings/developers" target="_blank" rel="noopener">discogs.com/settings/developers</a>
                    (free). Used to look up CDs when iTunes doesn't have a match.
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
            </div>
        </form>
    </div>
</div>

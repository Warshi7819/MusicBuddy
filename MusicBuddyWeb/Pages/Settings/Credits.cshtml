@page
@model MusicBuddyWeb.Pages.Settings.CreditsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Credits";
}

<h2 class="mb-2"><i class="bi bi-heart"></i> Credits</h2>
<p class="text-muted mb-4">
    Acknowledgements for open-source projects used in MusicBuddy.
</p>

<h4 class="mb-3">Audio Playback</h4>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Gapless-5</h5>
        <p class="card-text">
            The gapless audio playback engine is inspired by
            <a href="https://github.com/regosen/Gapless-5" target="_blank" rel="noopener">Gapless-5</a>
            by Rego Sen — a gapless JavaScript audio player using HTML5 and WebAudio.
        </p>
        <p class="card-text"><small class="text-muted">MIT License</small></p>
        <a href="https://github.com/regosen/Gapless-5" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-github me-1"></i>View on GitHub
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">WebSid</h5>
        <p class="card-text">
            The SID music player uses
            <a href="https://github.com/wothke/websid" target="_blank" rel="noopener">WebSid</a>
            by Juergen Wothke — a cycle-accurate C64 SID chip emulator compiled to WebAssembly.
        </p>
        <p class="card-text"><small class="text-muted">CC BY-NC-SA 4.0 License</small></p>
        <div class="d-flex gap-2">
            <a href="https://github.com/wothke/websid" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-github me-1"></i>View on GitHub
            </a>
            <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                License (CC BY-NC-SA 4.0)
            </a>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">jsSID</h5>
        <p class="card-text">
            SID music playback built on
            <a href="https://github.com/og2t/jsSID" target="_blank" rel="noopener">jsSID</a>
            version 0.9.1 by Hermit — a JavaScript SID chip emulator using Web Audio API.
        </p>
        <p class="card-text"><small class="text-muted">WTFPL — "Do what the f*** you want with this code."</small></p>
        <a href="https://github.com/og2t/jsSID" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-github me-1"></i>View on GitHub
        </a>
    </div>
</div>

<h4 class="mb-3">Barcode Scanning</h4>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">html5-qrcode</h5>
        <p class="card-text">
            The barcode scanner on the Scan CD page uses
            <a href="https://github.com/mebjas/html5-qrcode" target="_blank" rel="noopener">html5-qrcode</a>
            by Mebjas — a cross-platform QR/barcode scanning library supporting EAN-13, UPC-A, EAN-8, and CODE-128 formats.
        </p>
        <p class="card-text"><small class="text-muted">Apache-2.0 License</small></p>
        <a href="https://github.com/mebjas/html5-qrcode" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-github me-1"></i>View on GitHub
        </a>
    </div>
</div>

@model List<string>

<small class="text-muted ms-1" id="random-genre-count" hx-swap-oob="true">(@Model.Count)</small>

@if (Model.Count == 0)
{
    <span class="list-group-item text-muted small">No genres found</span>
}
else
{
    @foreach (var genre in Model)
    {
        <a href="#"
           class="list-group-item list-group-item-action"
           data-label="@genre.ToLower()"
           hx-get="/Albums?handler=RandomTrackView&genre=@Uri.EscapeDataString(genre)"
           hx-target="#albums-container"
           hx-swap="innerHTML"
           hx-push-url="true"
           onclick="bootstrap.Offcanvas.getInstance(document.getElementById('random-offcanvas')).hide();">
            @genre
        </a>
    }
}

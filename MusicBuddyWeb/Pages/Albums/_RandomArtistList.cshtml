@model List<string>

<small class="text-muted ms-1" id="random-artist-count" hx-swap-oob="true">(@Model.Count)</small>

@foreach (var artist in Model)
{
    <a href="#"
       class="list-group-item list-group-item-action"
       data-label="@artist.ToLower()"
       hx-get="/Albums?handler=RandomTrackView&artist=@Uri.EscapeDataString(artist)"
       hx-target="#albums-container"
       hx-swap="innerHTML"
       hx-push-url="true"
       onclick="bootstrap.Offcanvas.getInstance(document.getElementById('random-offcanvas')).hide();">
        @artist
    </a>
}

@model AlbumGridModel

<div class="d-flex justify-content-between align-items-center mb-2">
    <div class="d-flex align-items-center gap-2">
        <a href="/Albums"
           hx-get="/Albums?handler=ArtistGrid"
           hx-target="#albums-container"
           hx-swap="innerHTML"
           hx-push-url="true"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>All Artists
        </a>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="random-open-btn"
                onclick="bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('random-offcanvas')).show();">
            <i class="bi bi-shuffle me-1"></i>Random
        </button>
    </div>
</div>

<div class="mb-3">
    <span class="fs-5 fw-semibold">@Model.Artist.Name</span>
</div>

@if (Model.Artist.Albums.Count == 0)
{
    <div class="text-muted py-4">
        <i class="bi bi-music-note-beamed me-1"></i>No albums found.
    </div>
}
else
{
<div class="row">
@foreach (var album in Model.Artist.Albums)
{
    var isSelected = Model.ArtistArtMap.TryGetValue(Model.Artist.Name, out var chosen) && chosen == album.Path;

    <div class="col-6 col-md-4 col-lg-3 mb-3">
        <div class="card h-100 album-card" style="cursor:pointer;">
            <a href="/Albums?artist=@Uri.EscapeDataString(Model.Artist.Name)&album=@Uri.EscapeDataString(album.Path)"
               hx-get="/Albums?handler=TrackView&artist=@Uri.EscapeDataString(Model.Artist.Name)&album=@Uri.EscapeDataString(album.Path)"
               hx-target="#albums-container"
               hx-swap="innerHTML"
               hx-push-url="true"
               class="text-decoration-none">
                <div class="album-art-wrap">
                    @if (album.FirstTrackPath is not null)
                    {
                        <img class="album-art"
                             src="/api/albumart?path=@Uri.EscapeDataString(album.FirstTrackPath)"
                             loading="lazy"
                             decoding="async"
                             alt="@album.Name"
                             onload="if(this.naturalWidth===1&&this.naturalHeight===1){this.style.display='none';var n=this.nextElementSibling;if(n)n.style.display='';}"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='';">
                    }
                    <div class="album-art-placeholder" @(album.FirstTrackPath is not null ? Html.Raw("style=\"display:none\"") : "")>
                        <i class="bi bi-disc" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <div class="card-body">
                    <h6 class="card-title mb-1 text-truncate">@album.Name</h6>
                    <small class="text-muted d-block">@album.TrackCount track@(album.TrackCount != 1 ? "s" : "")</small>
                </div>
            </a>
            <div class="card-body pt-0">
                <button type="button"
                        class="btn btn-sm mt-2 album-art-btn @(isSelected ? "btn-success" : "btn-outline-secondary")"
                        data-action="set-artist-art"
                        data-artist-path="@Model.Artist.Name"
                        data-album-path="@album.Path"
                        onclick="setArtistArt(this)">
                    @if (isSelected)
                    {
                        <i class="bi bi-check me-1"></i><span>Selected</span>
                    }
                    else
                    {
                        <i class="bi bi-image me-1"></i><span>Use as artist image</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
</div>
}

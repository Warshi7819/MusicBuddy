@using System.Text.Json
@using System.Text.Json.Nodes
@{
    var themeCookie = Context.Request.Cookies["MusicBuddyTheme"];
    var bsTheme = "";
    var isDarkNavbar = false;
    string? customCss = null;
    string? navbarBg = null;
    string? navbarTextColor = null;
    var vuStyleCookie = Context.Request.Cookies["MusicBuddyVUMeter"];
    var vuStyle = (vuStyleCookie is "classic" or "glow" or "blueglow" or "greenglow" or "flatgold" or "ledbar" or "amberglow" or "oldschool") ? vuStyleCookie : "classic";

    if (themeCookie == "dark")
    {
        bsTheme = "dark";
        isDarkNavbar = true;
        navbarBg = "#343a40";
        navbarTextColor = "#ffffff";
        customCss = @"
:root {
    --bs-body-bg: #212529;
    --bs-body-color: #dee2e6;
    --bs-primary: #0d6efd;
    --bs-secondary-color: #adb5bd;
    --bs-border-color: #495057;
    --bs-card-bg: #343a40;
    --bs-card-border-color: #495057;
    --bs-tertiary-bg: #2b3035;
    --bs-navbar-bg: #343a40;
    --bs-navbar-color: #ffffff;
}";
    }
    else if (themeCookie == "light")
    {
        isDarkNavbar = false;
        navbarBg = "#0d6efd";
        navbarTextColor = "#ffffff";
        customCss = @"
:root {
    --bs-body-bg: #ffffff;
    --bs-body-color: #212529;
    --bs-primary: #0d6efd;
    --bs-secondary-color: #6c757d;
    --bs-border-color: #dee2e6;
    --bs-card-bg: #ffffff;
    --bs-card-border-color: rgba(0,0,0,0.125);
    --bs-tertiary-bg: #f8f9fa;
    --bs-navbar-bg: #0d6efd;
    --bs-navbar-color: #ffffff;
}";
    }
    else if (themeCookie is not null && themeCookie.StartsWith('{'))
    {
        try
        {
            var json = JsonNode.Parse(themeCookie);
            if (json is not null)
            {
                var bodyBg = (string?)json["BodyBg"] ?? "#ffffff";
                var bodyColor = (string?)json["BodyColor"] ?? "#212529";
                var cardBg = (string?)json["CardBg"] ?? "#ffffff";
                var cardBorder = (string?)json["CardBorderColor"] ?? "rgba(0,0,0,0.125)";
                var primary = (string?)json["PrimaryColor"] ?? "#0d6efd";
                var muted = (string?)json["MutedColor"] ?? "#6c757d";
                navbarBg = (string?)json["NavbarBg"] ?? "#0d6efd";
                navbarTextColor = (string?)json["NavbarTextColor"] ?? "#ffffff";
                var footerBg = (string?)json["FooterBg"] ?? "#f8f9fa";

                customCss = $@"
:root {{
    --bs-body-bg: {bodyBg};
    --bs-body-color: {bodyColor};
    --bs-primary: {primary};
    --bs-secondary-color: {muted};
    --bs-border-color: {cardBorder};
    --bs-card-bg: {cardBg};
    --bs-card-border-color: {cardBorder};
    --bs-tertiary-bg: {footerBg};
    --bs-navbar-bg: {navbarBg};
    --bs-navbar-color: {navbarTextColor};
}}";
                isDarkNavbar = IsDarkColor(navbarBg);
            }
        }
        catch { }
    }

    var navbarClass = isDarkNavbar ? "navbar-dark" : "navbar-light";
}

@functions {
    static bool IsDarkColor(string? color)
    {
        if (color is null) return true;
        var hex = color.TrimStart('#');
        if (hex.Length != 6 && hex.Length != 3) return true;
        if (hex.Length == 3) hex = string.Concat(hex[0], hex[0], hex[1], hex[1], hex[2], hex[2]);
        if (!int.TryParse(hex[..2], System.Globalization.NumberStyles.HexNumber, null, out var r)) return true;
        if (!int.TryParse(hex[2..4], System.Globalization.NumberStyles.HexNumber, null, out var g)) return true;
        if (!int.TryParse(hex[4..6], System.Globalization.NumberStyles.HexNumber, null, out var b)) return true;
        return (r * 0.299 + g * 0.587 + b * 0.114) < 128;
    }
}

<!DOCTYPE html>
<html lang="en"@(!string.IsNullOrEmpty(bsTheme) ? $" data-bs-theme=\"{bsTheme}\"" : "")>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MusicBuddy</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MusicBuddyWeb.styles.css" asp-append-version="true" />
    @if (customCss is not null)
    {
        <style>@Html.Raw(customCss)</style>
    }
</head>
<body data-vu-style="@vuStyle">
    <header>
        <nav class="navbar navbar-expand-sm @navbarClass @(customCss is not null ? "" : "bg-white") border-bottom shadow-sm mb-4"
             style="@(navbarBg is not null ? $"background-color:{navbarBg}" : null)">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <img src="~/images/logo-text.png" alt="MusicBuddy" height="32" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Albums"><i class="bi bi-disc me-1"></i>Albums</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Settings") == true ? "active" : "")"
                                   asp-page="/Settings/Themes">
                                    <i class="bi bi-gear-fill me-1"></i>Settings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Settings/Profile">
                                    <i class="bi bi-person-circle me-1"></i>@(User.FindFirst("Alias")?.Value ?? User.Identity?.Name)
                                </a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link btn btn-link">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container text-center small">
            &copy; @DateTime.UtcNow.Year MusicBuddy
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="Shared/_ConfirmModal" />
</body>
</html>

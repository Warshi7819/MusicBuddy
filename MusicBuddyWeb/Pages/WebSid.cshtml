@page
@model MusicBuddyWeb.Pages.WebSidModel
@{
    ViewData["Title"] = "webSID Player";
}

<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <a class="nav-link" asp-page="/Mp3"><i class="bi bi-file-earmark-music me-1"></i>MP3 Player</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-page="/Sid"><i class="bi bi-cassette me-1"></i>jsSID Player</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" asp-page="/WebSid"><i class="bi bi-cassette me-1"></i>webSID Player</a>
    </li>
</ul>

<div class="row">
    <div class="col-lg-8">
        <div class="d-flex justify-content-center mb-3">
            <canvas id="vu-canvas"></canvas>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div id="websid-now-playing" class="mb-3">
                    <h5 class="mb-1" id="websid-title">No track loaded</h5>
                    <small class="text-muted" id="websid-author"></small>
                    <div class="small text-muted mt-1" id="websid-info"></div>
                </div>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="text-muted small" id="websid-time">0:00</span>
                    <div class="flex-grow-1">
                        <div class="progress" style="height: 6px; cursor: pointer;" id="websid-seek-bar">
                            <div class="progress-bar bg-primary" id="websid-seek-fill" style="width: 0%"></div>
                        </div>
                    </div>
                    <span class="text-muted small" id="websid-duration"></span>
                </div>

                <div class="d-flex align-items-center justify-content-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" id="websid-prev" title="Previous track">
                        <i class="bi bi-skip-start-fill"></i>
                    </button>
                    <button class="btn btn-primary" id="websid-play" title="Play">
                        <i class="bi bi-play-fill"></i>
                    </button>
                    <button class="btn btn-outline-secondary" id="websid-pause" title="Pause" style="display:none;">
                        <i class="bi bi-pause-fill"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" id="websid-stop" title="Stop">
                        <i class="bi bi-stop-fill"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" id="websid-next" title="Next track">
                        <i class="bi bi-skip-end-fill"></i>
                    </button>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-volume-up text-muted"></i>
                        <input type="range" class="form-range" id="websid-volume" min="0" max="100" value="80" style="width: 100px;">
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Subtune:</span>
                        <button class="btn btn-outline-secondary btn-sm" id="websid-sub-down" disabled>-</button>
                        <span id="websid-subtune" class="small">1/1</span>
                        <button class="btn btn-outline-secondary btn-sm" id="websid-sub-up" disabled>+</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Model:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="websid-model" id="websid-model-6581" value="6581">
                            <label class="btn btn-outline-secondary" for="websid-model-6581">6581</label>
                            <input type="radio" class="btn-check" name="websid-model" id="websid-model-8580" value="8580" checked>
                            <label class="btn btn-outline-secondary" for="websid-model-8580">8580</label>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" id="websid-model-auto" title="Follow the model declared in the SID file">Auto</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span><i class="bi bi-music-note-list me-1"></i>Playlist</span>
                    <span class="badge bg-secondary" id="websid-count">0</span>
                </div>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" id="pm-playlist-select" style="min-width: 0;">
                        <option value="">-- All files --</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="pm-create-btn" title="New playlist">
                        <i class="bi bi-plus"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="pm-add-files-btn" title="Add files from browser" disabled>
                        <i class="bi bi-folder2-open"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="pm-delete-btn" title="Delete playlist" disabled>
                        <i class="bi bi-trash"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" id="pm-clear-btn" title="Clear all tracks" disabled>
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </div>
            <div class="list-group list-group-flush" id="websid-playlist" style="max-height: 500px; overflow-y: auto;">
            </div>
        </div>
    </div>
</div>

<hr />
<small class="text-muted">
    SID emulation powered by <a href="https://www.wothke.ch/websid/" target="_blank" rel="noopener">webSID</a>
    by Juergen Wothke. Licensed under
    <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>.
    <br />
    <br />
</small>


@section Scripts {
    <script src="~/js/vu-meter.js" asp-append-version="true"></script>
    <script>vuMeter.init('vu-canvas');</script>
    <script src="~/js/file-browser.js" asp-append-version="true"></script>
    <script src="~/js/playlist-manager.js" asp-append-version="true"></script>
    <script src="~/lib/websid/scriptprocessor_player.min.js"></script>
    <script>window.WASM_SEARCH_PATH = '/lib/websid/';</script>
    <script src="~/lib/websid/backend_websid.js"></script>
    <script src="~/js/websid-player.js" asp-append-version="true"></script>
    <script>
        (function () {
            websidPlayer.init([]);

            var select = document.getElementById('pm-playlist-select');

            playlistManager.init({
                fileType: 'sid',
                onPlaylistLoaded: function (data) {
                    if (data && data.tracks && data.tracks.length > 0) {
                        websidPlayer.loadPlaylist(data.tracks);
                    } else {
                        websidPlayer.loadPlaylist([]);
                    }
                }
            });

            select.addEventListener('change', function () {
                if (!this.value) {
                    websidPlayer.loadPlaylist([]);
                }
            });
        })();
    </script>
    <partial name="Shared/_FileBrowserModal" />
}
